<script>
  export default (props, { $f7, $on }) => {

    $on('pageInit', () => {
      const form = document.getElementById('login-form');

      form.addEventListener('submit', (e) => {
        // Mencegah reload halaman bawaan browser
        e.preventDefault();

        // Ambil data dari input form secara otomatis
        const formData = $f7.form.convertToData('#login-form');
        const username = formData.username;
        const password = formData.password;

        // Validasi tambahan sederhana (opsional)
        if (!username || !password) {
          $f7.dialog.alert('Harap isi semua kolom login!', 'Gagal');
          return;
        }

        // Tampilkan animasi loading modern khas Framework7
        $f7.dialog.preloader('Menyelaraskan Akun...');

        // Simulasi proses autentikasi (misal cek ke API selama 1.5 detik)
        setTimeout(() => {
          // Tutup animasi loading
          $f7.dialog.close();

          // Berpindah secara mulus ke halaman utama (Dashboard)
          $f7.views.main.router.navigate('/about/', {
            animate: true,
            pushState: true
          });

          // Memunculkan pesan toast selamat datang di halaman dashboard
          $f7.toast.create({
            text: `Selamat Datang Kembali, ${username}!`,
            position: 'bottom',
            closeTimeout: 2500,
            destroyOnClose: true
          }).open();

        }, 1500);
      });
    });

    $on('pageInit', () => {
      // 1. LOGIKA SUBMIT FORM BIASA (YANG SUDAH ADA)
      const form = document.getElementById('login-form');
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = $f7.form.convertToData('#login-form');
        handleSuccessLogin(formData.username || 'Mufid');
      });

      // 2. LOGIKA LOGIN DENGAN GOOGLE
      const googleBtn = document.getElementById('google-login-btn');
      googleBtn.addEventListener('click', (e) => {
        e.preventDefault();

        // Tampilkan loading khusus Google Auth
        $f7.dialog.preloader('Menghubungkan ke Google...');

        // Simulasi pembukaan SDK Google atau Popup Window
        setTimeout(() => {
          $f7.dialog.close();

          // Simulasi data yang didapat setelah user memilih akun Google mereka
          const googleUserSimulated = {
            displayName: "Mufid Rofi' Ali",
            email: "mufid.rofi@gmail.com"
          };

          // Panggil fungsi sukses masuk
          handleSuccessLogin(googleUserSimulated.displayName);

        }, 1800); // Waktu tunggu simulasi autentikasi Google
      });

      // REFACTOR: Fungsi reusable untuk mengalihkan halaman setelah sukses login
      function handleSuccessLogin(nameToDisplay) {
        $f7.dialog.preloader('Menyelaraskan Akun...');

        setTimeout(() => {
          $f7.dialog.close();

          // Berhasil Login menuju Dashboard Utama Anda
          $f7.views.main.router.navigate('/About/', {
            reloadCurrent: true
          });

          // Notifikasi Selamat Datang Pop-up Ringkas
          $f7.toast.create({
            text: `Selamat Datang Kembali, ${nameToDisplay}!`,
            position: 'bottom',
            closeTimeout: 2500,
            destroyOnClose: true
          }).open();

        }, 1000);
      }
    });
    return $render;
  };
</script>