<script>
    export default (props, { $f7, $on }) => {
        $on('pageInit', () => {
            // Tempat menambahkan handler klik hapus alamat atau ubah alamat utama
        });

        // 2. FUNGSI HAPUS ALAMAT (DENGAN KONFIRMASI)
        const konfirmasiHapus = () => {
            $f7.dialog.confirm(
                'Apakah Anda yakin ingin menghapus alamat pengiriman ini secara permanen?',
                'Hapus Alamat',
                () => {
                    // Blok ini dijalankan jika pengguna menekan tombol "OK" / "Ya"
                    $f7.dialog.preloader('Menghapus alamat...');

                    // Simulasi AJAX hapus ke server (1 detik)
                    setTimeout(() => {
                        $f7.dialog.close();
                        $f7.dialog.alert('Alamat telah berhasil dihapus.', 'Terhapus', () => {
                            $f7.views.main.router.back(); // Kembali ke daftar alamat
                        });
                        console.log('Alamat dengan ID terkait telah dihapus.');
                    }, 1000);
                }
            );
        };

        return $render;
    };
</script>