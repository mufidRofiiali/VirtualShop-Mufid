<script>
    export default (props, { $f7, $on }) => {

        $on('pageInit', () => {
            const form = document.getElementById('register-form');

            form.addEventListener('submit', (e) => {
                e.preventDefault();

                // Mengonversi data form menjadi objek JavaScript
                const formData = $f7.form.convertToData('#register-form');

                // Tampilkan animasi pembuatan akun
                $f7.dialog.preloader('Membuat Akun Enkripsi...');

                setTimeout(() => {
                    $f7.dialog.close();

                    // Tampilkan notifikasi toast sukses mendaftar
                    $f7.toast.create({
                        text: `Registrasi Berhasil! Selamat bergabung, ${formData.fullname}.`,
                        position: 'center',
                        closeTimeout: 3000,
                        destroyOnClose: true
                    }).open();

                    // Arahkan otomatis kembali ke halaman login utama setelah sukses
                    $f7.views.main.router.back();

                }, 2000);
            });
        });

        return $render;
    };
</script>