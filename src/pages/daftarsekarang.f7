        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .custom-input-list .item-input-wrap input {
        color: #ffffff !important;
        font-size: 15px !important;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
