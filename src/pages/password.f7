        <div class="page-content forgot-bg display-flex justify-content-center align-items-center">

            <div class="forgot-wrapper">
                <div class="forgot-header text-center">
                    <div class="lock-icon-box">
                        <i class="f7-icons">lock_open_fill</i>
                    </div>
                    <h2 class="forgot-title">Lupa Kata Sandi?</h2>
                    <p class="forgot-tagline">Jangan khawatir! Masukkan email Anda yang terdaftar untuk menerima
                        instruksi pemulihan akun.</p>
                </div>

                <div class="card glass-card forgot-card">
                    <div class="card-content card-content-padding">

                        <form id="forgot-form">
                            <div class="list no-hairlines-md custom-input-list">
                                <ul>
                                    <li class="item-content item-input item-input-with-info">
                                        <div class="item-media">
                                            <i class="f7-icons field-icon">envelope_fill</i>
                                        </div>
                                        <div class="item-inner">
                                            <div class="item-title item-label">Alamat Email</div>
                                            <div class="item-input-wrap">
                                                <input type="email" name="email" placeholder="contoh@email.com" required
                                                    validate />
                                                <span class="input-clear-button"></span>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>

                            <div class="block no-margin-horizontal button-block">
                                <button type="submit" class="button button-fill forgot-submit-btn">
                                    Kirim Tautan Reset <i class="f7-icons margin-left-half">paperplane_fill</i>
                                </button>
                            </div>
                        </form>

                    </div>
                </div>

                <div class="forgot-footer text-center">
                    <p>Ingat kata sandi Anda? <a href="#" class="link back-to-login back">Masuk Kembali</a></p>
                </div>

            </div>

        </div>
    </div>
</template>

<style>
    /* Base & Fonts */
    .forgot-page {
        font-family: -apple-system, SF Pro Text, Roboto, sans-serif;
    }

    /* Navbar Styling */
    .forgot-page .navbar .navbar-bg {
        background-color: #111827;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .forgot-page .navbar .title {
        color: #ffffff;
        font-weight: 800;
    }

    .forgot-page .navbar .f7-icons {
        color: #60a5fa;
    }

    /* Cyberpunk Background Engine */
    .forgot-bg {
        background-color: #0b0f19;
        background-image:
            radial-gradient(circle at top right, rgba(32, 93, 247, 0.2), transparent 45%),
            radial-gradient(circle at bottom left, rgba(239, 68, 68, 0.12), transparent 45%);
        background-attachment: fixed;
        min-height: 100vh;
        box-sizing: border-box;
        padding: 24px;
    }

    .forgot-wrapper {
        width: 100%;
        max-width: 400px;
        margin-top: 40px;
        /* Jarak dari navbar */
        animation: fadeInForgot 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeInForgot {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header Icon & Text */
    .forgot-header {
        margin-bottom: 24px;
    }

    .lock-icon-box {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(239, 68, 68, 0.3);
        margin-bottom: 14px;
    }

    .lock-icon-box .f7-icons {
        font-size: 26px;
        color: #ffffff;
    }

    .forgot-title {
        color: #ffffff;
        font-size: 22px;
        font-weight: 700;
        margin: 0;
    }

    .forgot-tagline {
        color: #94a3b8;
        font-size: 13px;
        margin: 8px 12px 0 12px;
        line-height: 1.5;
    }

    /* Glassmorphism Card Formula */
    .forgot-card {
        background: rgba(255, 255, 255, 0.04) !important;
        backdrop-filter: blur(25px) !important;
        -webkit-backdrop-filter: blur(25px) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 24px !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5) !important;
        margin: 0 !important;
    }

    /* Input Fields */
    .custom-input-list {
        margin: 12px 0 20px 0 !important;
        background: transparent !important;
    }

    .custom-input-list ul {
        background: transparent !important;
        border: none !important;
    }

    .custom-input-list ul::before,
    .custom-input-list ul::after {
        display: none !important;
    }

    .custom-input-list .item-content {
        padding-left: 0 !important;
    }

    .custom-input-list .field-icon {
        font-size: 22px;
        color: #60a5fa;
        margin-top: 20px;
    }

    .custom-input-list .item-label {
        color: #94a3b8 !important;
        font-size: 11px !important;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .custom-input-list .item-input-wrap input {
        color: #ffffff !important;
        font-size: 15px !important;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
        height: 42px;
    }

    .custom-input-list .item-input-wrap input:focus {
        border-bottom-color: #ef4444 !important;
        /* Aksen merah saat fokus sesuai icon */
    }

    /* Submit Button */
    .forgot-submit-btn {
        background: linear-gradient(90deg, #ef4444, #b91c1c) !important;
        color: #ffffff !important;
        height: 48px;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 700;
        text-transform: none;
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
    }

