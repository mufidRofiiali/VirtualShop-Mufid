        color: #00e5ff !important;
        font-weight: 600;
    }
</style>

<script>
    export default (props, { $f7, $on }) => {

        $on('pageInit', () => {
            const form = document.getElementById('forgot-form');

            form.addEventListener('submit', (e) => {
                e.preventDefault();

                const formData = $f7.form.convertToData('#forgot-form');
                const email = formData.email;

                // Jalankan loading animasi
                $f7.dialog.preloader('Menghubungi Server Keamanan...');

                setTimeout(() => {
                    $f7.dialog.close();

                    // Berikan popup dialog sukses informasi kepada user
                    $f7.dialog.alert(
                        `Tautan pemulihan sandi telah berhasil dikirim ke <b>${email}</b>. Silakan periksa kotak masuk atau folder spam email Anda.`,
                        'Email Terkirim',
                        () => {
                            // Setelah user klik OK, kembalikan otomatis ke halaman login awal
                            $f7.views.main.router.back();
                        }
                    );

                }, 1800);
            });
        });

        return $render;
    };
</script>