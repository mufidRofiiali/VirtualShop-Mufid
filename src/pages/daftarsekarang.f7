    .register-wrapper {
        width: 100%;
        max-width: 400px;
        margin-top: 40px;
        /* Jarak aman dari navbar */
        animation: fadeInRegister 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeInRegister {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Brand / Logo Section */
    .register-brand {
        margin-bottom: 24px;
    }

    .brand-icon-box {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #00e5ff, #205DF7);
        border-radius: 20px;
        display: inline-flex;
