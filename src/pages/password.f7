<template>
    <div class="page forgot-page" data-name="forgot">

        <div class="navbar navbar-center no-shadow">
            <div class="navbar-bg"></div>
            <div class="navbar-inner sliding">
                <div class="left">
                    <a href="#" class="link icon-only back">
