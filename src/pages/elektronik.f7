<script>
    export default (props, { $f7, $onMounted, $ }) => {

        $onMounted(() => {
            // 1. ENGINE TOGGLE THEME MANAGEMENT
            $('#dark-mode-checkbox').on('change', function () {
                const isDarkMode = $(this).is(':checked');
                if (isDarkMode) {
                    $f7.setDarkMode(true);
                } else {
                    $f7.setDarkMode(false);
                }
            });

            // 2. INITIALIZE SWIPER CONTEXT SHOWCASE
            const swiper = $f7.swiper.create('#mySwiper', {
                slidesPerView: 1,
                spaceBetween: 10,
                effect: 'fade',
                loop: true,
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
            });

            // 3. SEARCH RUNTIME FILTER LOGIC
            $('.custom-search input').on('input', function () {
                const value = $(this).val().toLowerCase();
                $('.product-grid-layout .product-card').each(function () {
                    const productName = $(this).find('.product-title').text().toLowerCase();
                    if (productName.indexOf(value) > -1) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // 4. CHIP CATEGORY INTERACTION TRIGGER
            $('.category-scroll .chip').on('click', function () {
                $('.category-scroll .chip').removeClass('chip-active');
                $(this).addClass('chip-active');

                $f7.toast.create({
                    text: `Filter kategori: ${$(this).text()}`,
                    closeTimeout: 1500,
                    position: 'center'
                }).open();
            });

            // 5. DROPDOWN SELECTION ALERT
            $('.filter-row select').on('change', function () {
                const selectedOpt = $(this).find('option:selected').text();
                $f7.dialog.alert(`Mengurutkan data berdasarkan: <b>${selectedOpt}</b>`, 'Filter Aktif');
            });

            // 6. TOGGLE WISHLIST ACTION
            $('.product-grid-layout').on('click', '.wishlist', function (e) {
                e.stopPropagation();
                const productName = $(this).siblings('.product-info').find('.product-title').text();

                if ($(this).hasClass('gray')) {
                    $(this).removeClass('gray').text('❤');
                    $f7.toast.create({ text: `❤️ ${productName} disimpan!`, closeTimeout: 1500, position: 'center' }).open();
                } else {
                    $(this).addClass('gray').text('♡');
                    $f7.toast.create({ text: `💔 ${productName} dihapus.`, closeTimeout: 1500, position: 'center' }).open();
                }
            });

            // 7. ADD TO CART SUBMIT SYSTEM
            $('.product-grid-layout').on('click', '.add-to-cart-btn', function (e) {
                e.preventDefault();
                const productName = $(this).siblings('.product-title').text();

                $f7.toast.create({
                    text: `🛒 ${productName} masuk keranjang!`,
                    closeTimeout: 2000,
                    position: 'bottom',
                    destroyOnClose: true
                }).open();
            });

        });

        return $render;
    };
</script>